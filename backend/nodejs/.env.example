# Backend Node.js - Configuração

# Porta do servidor WebSocket
PORT=3000

# Configuração padrão do PLC (opcional)
PLC_IP=192.168.0.1
PLC_PORT=5000

# Timeout de conexão (em milissegundos)
CONNECTION_TIMEOUT=10000

# Intervalo de leitura contínua (em milissegundos)
READ_INTERVAL=1000

# Ambiente (development, production)
NODE_ENV=development
